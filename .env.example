# ============================================
# Application Configuration
# ============================================

# Application environment (dev, staging, production, release)
PUBLIC_APP_ENVIRONMENT=release

# Application name
PUBLIC_APP_NAME=abandonment

# Application version
PUBLIC_APP_VERSION=1.0.0

# Build timestamp (auto-generated during build)
PUBLIC_BUILD_TIMESTAMP=

# ============================================
# OpenTelemetry Configuration
# ============================================

# Enable/disable OpenTelemetry (set to 'false' for local dev to reduce noise)
ENABLE_TELEMETRY=true

# OpenTelemetry collector endpoint
OTEL_COLLECTOR_ENDPOINT=https://crane.beta.breeze.in

# ============================================
# Checkout Configuration
# ============================================

# Default actions.js filename (with hash)
# This is used as a fallback when the actions.js URL cannot be extracted from the checkout HTML
DEFAULT_ACTIONS_JS_FILENAME=actions.B_hz6_NC.js

# Default checkout source ID for Shopify headers
# This is used when checkout source ID cannot be extracted
CHECKOUT_SOURCE_ID=hWN7RSCPlrSvAz7GAb0tQX2X

# Default checkout type (cn = checkout node)
CHECKOUT_TYPE=cn

# ============================================
# Network Configuration
# ============================================

# Enable/disable Tor proxy for abandonment requests
# Set to 'true' to route requests through Tor (default)
# Set to 'false' to make direct requests without Tor
ENABLE_TOR=true
