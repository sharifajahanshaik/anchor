# ============================================
# Application Configuration
# ============================================

# Application environment (dev, staging, production, release)
PUBLIC_APP_ENVIRONMENT=release

# Application name
PUBLIC_APP_NAME=abandonment

# Application version
PUBLIC_APP_VERSION=1.0.0

# Build timestamp (auto-generated during build)
PUBLIC_BUILD_TIMESTAMP=

# ============================================
# OpenTelemetry Configuration
# ============================================

# Enable/disable OpenTelemetry (set to 'false' for local dev to reduce noise)
ENABLE_TELEMETRY=true

# OpenTelemetry collector endpoint
OTEL_COLLECTOR_ENDPOINT=https://crane.beta.breeze.in

# ============================================
# External Services (OPTIONAL)
# ============================================

# Slack webhook URL for notifications/alerts
SLACK_WEBHOOK_URL=

# Crane service endpoint (if using external crane service)
CRANE_ENDPOINT=
